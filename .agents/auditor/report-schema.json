{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "task": {
      "type": "string"
    },
    "claims": {
      "type": "object",
      "properties": {
        "implemented": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "deployed": { "type": "boolean" },
        "productionVerified": { "type": "boolean" }
      },
      "required": ["implemented", "verified", "deployed", "productionVerified"]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gitDiff": { "type": "boolean" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": { "type": "string" },
              "result": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        },
        "commitHash": { "type": "string" },
        "branch": { "type": "string" },
        "deploymentVersion": { "type": "string" },
        "claspPushResult": { "type": "string" },
        "runtimeCheck": {
          "type": ["object", "null"],
          "properties": {
            "content": { "type": "string" },
            "result": { "type": "string" },
            "timestamp": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["task", "claims", "evidence"]
}
